# 🔧 CONFIGURAÇÃO OCI - NSTECH RECOMMENDATION SYSTEM
# 🏆 Hackathon Conecta - Oracle Cloud Infrastructure
# 
# ⚠️  IMPORTANTE: 
# 1. Copie este arquivo para .env e preencha com suas credenciais reais
# 2. O arquivo .env é ignorado pelo git automaticamente
# 3. NUNCA commite credenciais reais no repositório!

# =============================================================================
# 🌐 CONFIGURAÇÕES BÁSICAS OCI (OBRIGATÓRIAS)
# =============================================================================

# Namespace do Object Storage
# 📍 Console OCI > Object Storage > Buckets > Namespace aparece no topo
OCI_NAMESPACE=seu-namespace-aqui

# Bucket para dados e artefatos
OCI_BUCKET_NAME=nstech-recommendation-data

# Região OCI (configurada pela equipe Oracle para o hackathon)
OCI_REGION=us-chicago-1

# =============================================================================
# 🔑 IDs DOS RECURSOS OCI (OBRIGATÓRIOS)
# =============================================================================

# ID do Compartment
# 📍 Console OCI > Identity > Compartments > Clique no compartment > Copie o OCID
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..seu-compartment-id-aqui

# ID do Projeto Data Science
# 📍 Console OCI > Data Science > Projects > Clique no projeto > Copie o OCID
OCI_PROJECT_ID=ocid1.datascienceproject.oc1.us-chicago-1.seu-project-id-aqui

# ID do Modelo (será criado após o primeiro deploy)
# 📍 Console OCI > Data Science > Models > Clique no modelo > Copie o OCID
OCI_MODEL_ID=ocid1.datasciencemodel.oc1.us-chicago-1.seu-model-id-aqui

# =============================================================================
# 🔐 CONFIGURAÇÕES DE AUTENTICAÇÃO (OPCIONAIS)
# =============================================================================

# Arquivo de configuração OCI (usa padrão se não definido)
OCI_CONFIG_FILE=~/.oci/config

# Profile do arquivo de configuração (usa DEFAULT se não definido)
OCI_CONFIG_PROFILE=DEFAULT

# Arquivo da chave privada (usa padrão se não definido)
OCI_KEY_FILE=~/.oci/private_key.pem

# =============================================================================
# 🏗️  CONFIGURAÇÕES DO PROJETO HACKATHON
# =============================================================================

# Informações do Projeto
PROJECT_NAME=nstech-hackathon-recommendation
PROJECT_DESCRIPTION="Sistema de recomendação para nsApps - POC ML/AI"

# Configurações de infraestrutura liberadas para hackathon
NOTEBOOK_SHAPE=VM.Standard.E4.Flex
NOTEBOOK_OCPUS=4
NOTEBOOK_MEMORY_GB=64
NOTEBOOK_BLOCK_STORAGE_GB=100

# Ambiente Data Science
CONDA_ENV_NAME=nstech_ml
PYTHON_VERSION=3.8

# =============================================================================
# 📊 CONFIGURAÇÕES DO MODELO ML
# =============================================================================

# Arquivos de dados
DATA_SOURCE_FILE=consolidated_datasource.json
LOCAL_DATA_PATH=../data/consolidated_datasource.json

# Parâmetros do modelo
MAX_RECOMMENDATIONS=5
SIMILARITY_THRESHOLD=0.3
CONVERSION_RATE=0.15
AVG_MRR_PER_PRODUCT=8000

# =============================================================================
# 🚀 INSTRUÇÕES DE USO
# =============================================================================

# 1. PREENCHER CREDENCIAIS:
#    - Substitua todos os valores "seu-*-aqui" pelos seus valores reais do OCI
#
# 2. SALVAR COMO .env:
#    - Copie este arquivo: cp .env.template .env
#    - Edite o .env com suas credenciais
#
# 3. VALIDAR CONFIGURAÇÃO:
#    - Execute: python config_oci.py
#
# 4. USAR NO NOTEBOOK:
#    - USE_OCI = True (para usar OCI)
#    - USE_OCI = False (para usar local)
